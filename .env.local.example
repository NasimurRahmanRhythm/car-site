NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin of the deployed site, no trailing slash. Optional on Vercel —
# VERCEL_PROJECT_PRODUCTION_URL is used automatically, and src/lib/site-url.ts
# falls back to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.vipmotorsbd.com

# --- Transactional email (Resend) -----------------------------------------
# Used by the site itself for appointment emails. This is NOT the key Supabase
# uses for login codes — that one is pasted into the Supabase SMTP settings as
# the password, not stored here.
RESEND_API_KEY=re_your_api_key

# Must be on a domain verified in Resend, or every send is rejected.
RESEND_FROM_EMAIL=VIP Motors <noreply@vipmotorsbd.com>
