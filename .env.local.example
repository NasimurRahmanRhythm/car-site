NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute origin of the deployed site, no trailing slash. Optional on Vercel —
# VERCEL_PROJECT_PRODUCTION_URL is used automatically. Set this once a custom
# domain is in place (e.g. https://vipmotors.com).
NEXT_PUBLIC_SITE_URL=
